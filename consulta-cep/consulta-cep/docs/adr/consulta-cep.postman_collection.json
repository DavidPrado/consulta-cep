              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"cep\": \"01310100\",\n    \"logradouro\": \"Avenida Paulista\",\n    \"bairro\": \"Bela Vista\",\n    \"cidade\": \"São Paulo\",\n    \"uf\": \"SP\",\n    \"prazoDias\": 2,\n    \"taxa\": 15.90\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/cobertura/ceps",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "cobertura", "ceps"]
            },
            "description": "Cadastra um CEP com dados próprios (priorizado na busca)."
          },
          "response": []
        },
        {
          "name": "Cadastrar CEP duplicado (409)",
