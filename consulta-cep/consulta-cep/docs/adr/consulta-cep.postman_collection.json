    {
      "name": "📦 3. Motor de Lote",
      "item": [
        {
          "name": "Criar lote com 10 CEPs",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 202\", function () { pm.response.to.have.status(202); });",
                  "const jsonData = pm.response.json();",
                  "if (jsonData.loteId) {",
                  "    pm.collectionVariables.set(\"loteId\", jsonData.loteId);",
                  "    console.log(\"LoteId salvo: \" + jsonData.loteId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"ceps\": [\n        \"01310100\", \"20040002\", \"30130010\", \"70040010\", \"90010150\",\n        \"60165080\", \"80010000\", \"88010400\", \"69005040\", \"66010000\"\n    ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/lotes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "lotes"]
            },
            "description": "Cria um lote de CEPs. Processamento é assíncrono via worker.\nO `loteId` é salvo automaticamente na variável de coleção."
          },
          "response": []
