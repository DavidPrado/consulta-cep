          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"cep\": \"01310100' OR 1=1--\",\n    \"uf\": \"SP\",\n    \"prazoDias\": 2,\n    \"taxa\": 15.90\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/cobertura/ceps",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "cobertura", "ceps"]
            },
            "description": "Tenta SQL Injection. O regex `\\d{8}` bloqueia antes de chegar ao banco. Espera 400."
          },
          "response": []
        },
